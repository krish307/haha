   $repoUrl = "https://github.com/krish307/haha.git"
   $dest = "C:\Scripts"


   Remove-Item $dest -Recurse -Force -ErrorAction SilentlyContinue
   New-Item -Path $dest -ItemType Directory -Force | Out-Null

   git clone $repoUrl "$env:TEMP\haha"
   Copy-Item "$env:TEMP\haha\scripts\*" $dest -Recurse -Force
   Remove-Item "$env:TEMP\haha" -Recurse -Force
   Write-Host "Deployed at $dest"
  
   attrib +h +s $dest

   Get-ChildItem $dest
   Test-Path "C:\Scripts\pipeline.ps1"

#start
Get-Process powershell -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -eq "" } | Stop-Process -Force


Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -like "*Pipeline*" } | Unregister-ScheduledTask -Confirm:$false


Remove-Item "C:\Scripts\pipeline.lock" -Force -ErrorAction SilentlyContinue


$scriptPath = "C:\Scripts\pipeline.ps1"
$content = Get-Content $scriptPath -Raw
if ($content -notmatch "pipeline\.lock") {
    $lockCode = @'
$LockFile = "C:\Scripts\pipeline.lock"
if (Test-Path $LockFile) { exit }
New-Item -Path $LockFile -ItemType File -Force | Out-Null
Register-EngineEvent PowerShell.Exiting -Action { Remove-Item "C:\Scripts\pipeline.lock" -Force -ErrorAction SilentlyContinue } | Out-Null

'@
    Set-Content -Path $scriptPath -Value ($lockCode + $content)
}


Start-Process powershell.exe -ArgumentList "-NoProfile -ExecutionPolicy Bypass -File `"C:\Scripts\pipeline.ps1`"" -WindowStyle Hidden -WorkingDirectory "C:\Scripts"


$action = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"C:\Scripts\pipeline.ps1`"" -WorkingDirectory "C:\Scripts"
$trigger = New-ScheduledTaskTrigger -AtLogOn
$settings = New-ScheduledTaskSettingsSet -Hidden -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero)
Register-ScheduledTask -TaskName "MyPipelineJob" -Action $action -Trigger $trigger -Settings $settings -RunLevel Highest



#check
Get-Process powershell | Select-Object Id, StartTime; Get-Content "C:\Scripts\output.log" -Tail 10
Write-Host "Done. Running now, and will auto-start on every future login."

#stop
Get-Process powershell -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowTitle -eq "" } | Stop-Process -Force
Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskName -like "*Pipeline*" } | Unregister-ScheduledTask -Confirm:$false
Remove-Item "C:\Scripts\pipeline.lock" -Force -ErrorAction SilentlyContinue
Write-Host "Stopped. Pipeline killed and auto-start removed."





